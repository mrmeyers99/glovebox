{
  "name": "glovebox",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w web",
    "test:coverage": "npm run test:coverage -w web",
    "test:db": "bash supabase/tests/run-local.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "web/**/*.{ts,tsx,js,jsx}": "oxlint --deny-warnings -c web/.oxlintrc.json"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1"
  }
}
