# Copy to .env.local and fill in from your Supabase project.
# Find both values via the Connect button at the top of the Supabase dashboard,
# or under Project Settings → API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key starts with sb_publishable_. It is safe to ship to the browser.
# Never use the sb_secret_ key here: it bypasses row-level security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
